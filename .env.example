# Copy to .env (or paste the keys in the dashboard, which writes this file for you).
# Never commit .env.

# fal.ai key for images, video, voice and analysis: https://fal.ai/dashboard/keys
FAL_KEY=

# Anthropic key for the agent itself: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: use a gateway instead of a direct key
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

# Optional settings
# MA_PORT=3333
# MA_LANGUAGE=English            # language of reference analyses
# MA_ANALYSIS_MODEL=google/gemini-2.5-flash
# MA_THINKING=off                # set to on for extended thinking
